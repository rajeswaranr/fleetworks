# ======= VIDEO TELEMETRY & DASHCAM CONFIGURATION =======
# Copy this to .env.local and fill in your actual values

# ======= AWS S3 (Video Storage) =======
VITE_AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
VITE_AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
VITE_AWS_REGION=us-east-1
VITE_VIDEO_BUCKET=fleetworks-videos

# ======= CloudFront CDN (Optional, for faster playback) =======
# Leave blank to use S3 URLs directly
VITE_CDN_DOMAIN=d123abc.cloudfront.net

# ======= Supabase (Database & Edge Functions) =======
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Internal (for Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ======= Integrations =======

# Samsara Integration
SAMSARA_API_TOKEN=pat_abc123def456
SAMSARA_WEBHOOK_SECRET=webhook_secret_xyz789

# Viofo or Generic RTMP (if not using Samsara)
RTMP_SERVER_URL=rtmp://your-server.com/live
RTMP_STREAM_KEY_PREFIX=vehicle_

# ======= Notifications =======

# Firebase Cloud Messaging (for push notifications)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQ...
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-abc@your-firebase-project.iam.gserviceaccount.com

# SendGrid (for email alerts)
SENDGRID_API_KEY=SG.your_sendgrid_key_here

# Twilio (for SMS alerts)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1234567890

# ======= Video Processing Settings =======

# Retention policy
VIDEO_RETENTION_DAYS=90

# Auto-transcoding (if using Wowza)
WOWZA_SERVER_URL=http://localhost:8087
WOWZA_API_KEY=your_wowza_key

# Video quality/bitrate
VIDEO_MAX_BITRATE_MBPS=10
VIDEO_RESOLUTION=1920x1080
VIDEO_FPS=30

# ======= Feature Flags =======

# Enable live streaming (requires more infrastructure)
ENABLE_LIVE_STREAMING=false

# Enable AI-powered event detection (requires ML model)
ENABLE_AI_DETECTION=true

# Auto-tag drivers/vehicles in video events
ENABLE_AUTO_TAGGING=true

# ======= Webhook Security =======

# Secret for validating webhook requests
VIDEO_WEBHOOK_SECRET=webhook_secret_change_me_in_production

# IP whitelist for webhooks (comma-separated)
WEBHOOK_IP_WHITELIST=203.0.113.0,198.51.100.0

# ======= Debugging =======

# Enable verbose logging for video ingestion
DEBUG_VIDEO_INGESTION=false

# Save S3 upload URLs to logs
DEBUG_S3_URLS=false
