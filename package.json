{
  "name": "fleetworks",
  "version": "1.0.0",
  "private": true,
  "description": "FleetWorks static web app",
  "scripts": {
    "start": "node server/static-server.mjs",
    "serve": "node server/static-server.mjs",
    "dev": "node server/static-server.mjs",
    "build": "npm test && node -e \"console.log('Static app assets are ready. Start with npm start or npm run dev.')\"",
    "test": "node --test tests/*.test.mjs && npm --prefix db/tests test",
    "ui:audit": "node tools/ui-audit.mjs",
    "ui:audit:strict": "node tools/ui-audit.mjs --strict",
    "ui:collisions": "node tools/global-collisions.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "acorn": "^8.18.0",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "html2pdf.js": "^0.14.0"
  }
}
